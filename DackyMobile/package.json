{
  "name": "dacky-mobile-offline-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Offline-first Vietnamese strategy game; source and assets authored for this project.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.js",
    "test:source": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "data:mobile:import": "node scripts/import_mobile_runtime.mjs",
    "data:mobile:assets": "NODE_USE_ENV_PROXY=1 node scripts/download_mobile_assets.mjs",
    "data:export": "node scripts/export-database.mjs",
    "data:coverage": "python3 scripts/update_data_coverage.py",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:build:debug": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2"
  }
}
